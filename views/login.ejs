<%- include("templates/header") %>
    <h1>Log in</h1>
    <form action="/loggingin" method="post" class="d-grid gap-3 col-12 col-md-6 col-lg-4">
        <input name="email" type="text" placeholder="user@domain.com" class="form-control rounded-pill">
        <input name="password" type="password" placeholder="password" class="form-control rounded-pill">
        <button type="submit" class="btn btn-primary rounded-pill">Submit</button>
    </form>
    <p><a href="/signup">Need an account? Sign up</a></p>
    <%- include("templates/footer") %>