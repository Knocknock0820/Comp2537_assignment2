<%- include("templates/header") %>
    <h1>Create user</h1>
    <% if (typeof errors !=="undefined" && errors.length> 0) { %>
        <div>
            <h2>Errors</h2>
            <ul>
                <% errors.forEach((errorMessage)=> { %>
                    <li>
                        <%= errorMessage %>
                    </li>
                    <% }) %>
            </ul>
        </div>
        <% } %>
            <form action="/submitUser" method="post" class="d-grid gap-3 col-12 col-md-6 col-lg-4">
                <input name="name" type="text" placeholder="name" class="form-control rounded-pill">
                <input name="email" type="text" placeholder="user@domain.com" class="form-control rounded-pill">
                <input name="password" type="password" placeholder="password" class="form-control rounded-pill">
                <button type="submit" class="btn btn-primary rounded-pill">Submit</button>
            </form>
            <p><a href="/login">Already have an account? Log in</a></p>
            <%- include("templates/footer") %>