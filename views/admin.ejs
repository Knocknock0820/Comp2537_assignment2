<%- include("templates/header") %>

    <% if (typeof error !=="undefined" ) { %>
        <h1>403 Forbidden</h1>
        <p>
            <%= error %>
        </p>
        <p><a href="/login">Back to login</a></p>
        <% } else { %>
            <h1>Admin Dashboard</h1>
            <p>Manage user roles in the database.</p>

            <% if (users && users.length> 0) { %>
                <table style="border-collapse:collapse; margin-top:16px;">
                    <thead>
                        <tr>
                            <th style="padding:10px 14px; text-align:left;">Name</th>
                            <th style="padding:10px 14px; text-align:left;">Email</th>
                            <th style="padding:10px 14px; text-align:left;">Type</th>
                            <th style="padding:10px 14px; text-align:left;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach((user)=> { %>
                            <tr>
                                <td style="padding:10px 14px;">
                                    <%= user.name %>
                                </td>
                                <td style="padding:10px 14px;">
                                    <%= user.email %>
                                </td>
                                <td style="padding:10px 14px;">
                                    <%= user.user_type %>
                                </td>
                                <td style="padding:10px 14px;">
                                    <form action="/admin/promote" method="post" class="d-inline-block me-2">
                                        <input type="hidden" name="email" value="<%= user.email %>">
                                        <button type="submit" class="btn btn-success rounded-pill">Promote</button>
                                    </form>
                                    <form action="/admin/demote" method="post" class="d-inline-block">
                                        <input type="hidden" name="email" value="<%= user.email %>">
                                        <button type="submit" class="btn btn-danger rounded-pill">Demote</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
                <% } else { %>
                    <p>No users found.</p>
                    <% } %>
                        <% } %>

                            <%- include("templates/footer") %>